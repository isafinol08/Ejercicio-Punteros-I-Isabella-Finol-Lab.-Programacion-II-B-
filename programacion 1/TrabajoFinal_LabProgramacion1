void indicartipocliente(short int f, short int c, Asiento matriz[8][10]) {
    short int edad = matriz[f][c].edad;

    if (edad >= 1 && edad < 18) {
        matriz[f][c].tipocliente = MENOR;
    } else if (edad >= 18 && edad < 60) {
        matriz[f][c].tipocliente = ADULTO;
    } else if (edad >= 60 && edad < 100) {
        matriz[f][c].tipocliente = ADULTO_MAYOR;
    } 
}

void pedirCedula(string &cedula) {
    bool valida = false;
    do {
        cout << "Ingrese su cedula (maximo 8 digitos): ";
        cin >> cedula;

        if (cedula.length() > 8) {
            cout << "Error: Cedula invalida. Excede los 8 digitos permitidos." << endl;
            continue;
        }

        bool esNumero = true;
        for (size_t i = 0; i < cedula.length(); i++) {
            if (!isdigit(cedula[i])) {
                esNumero = false;
                break;
            }
        }

        if (!esNumero) {
            cout << "Error: Cedula invalida. Solo debe contener numeros." << endl;
        } else {
            valida = true;
        }

    } while (!valida);
}

