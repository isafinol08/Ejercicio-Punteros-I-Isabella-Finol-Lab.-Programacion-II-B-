void comprarasiento(short int &f, short int &c, Asiento matriz[8][10]) {
    short int cantidad = 0;
    cout << "¿Cuantas entradas deseas comprar?: ";
    cin >> cantidad;

    while (cin.fail() || cantidad <= 0) {
        error(cantidad);
    }

    for (int i = 0; i < cantidad; i++) {
        system("cls");
        cout << "========================================" << endl;
        cout << "   COMPRA DE ENTRADA " << (i + 1) << " DE " << cantidad << endl;
        cout << "========================================" << endl;

        mostrarmapa(matriz);
        pedircoordenadas(f, c);
        comprobarasiento(f, c);

        while (matriz[f][c].ocupado) {
            cout << "\n¡El asiento " << (f + 1) << "-" << (c + 1) << " ya esta ocupado! Selecciona otro." << endl;
            pedircoordenadas(f, c);
            comprobarasiento(f, c);
        }

        cout << "\nIngrese los datos de la persona:" << endl;
        
        // 1. Lectura del Nombre Completo (soporta espacios)
        pedirNombreCompleto(matriz[f][c].nombre);

        // 2. Validación de Cédula (máximo 8 dígitos)
        pedirCedula(matriz[f][c].cedula);

        // 3. Validación de Edad (máximo 100)
        cout << "Edad: ";
        cin >> matriz[f][c].edad;

        while (cin.fail() || matriz[f][c].edad <= 0 || matriz[f][c].edad > 100) {
            if (matriz[f][c].edad > 100) {
                cout << "Error: Como es que sigues vivo bro? La edad no puede ser mayor a 100." << endl;
            } else {
                cout << "Error: Por favor introduce una edad valida (1 - 100)." << endl;
            }
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Ingrese la edad nuevamente: ";
            cin >> matriz[f][c].edad;
        }

        indicartipocliente(f, c, matriz);
        matriz[f][c].ocupado = true;

        cout << "\n-> ¡Asiento " << (f + 1) << "-" << (c + 1) << " registrado a nombre de " 
             << matriz[f][c].nombre << " con exito!" << endl;
        pausarylimpiar();
    }
}

